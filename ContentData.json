        {
          "id": "recipe-001",
          "name": "The Show Stopper",
          "tag": "Artist Staple",
          "prepTime": "10 mins",
          "ingredients": [
            "2 slices of Artesano Original White Bread",
            "3 slices of Kirkland Signature Extra Lean Uncured Ham",
            "2 slices of Adams Reserve Extra Sharp Cheddar",
            "1 tbsp Kirkland Grass-Fed salted butter (room temperature)",
            "1 tbsp Chosen Foods Avocado Oil Classic Mayo"
          ],
          "instructions": [
            "Mix the butter with the mayo.",
            "Generously spread the combo on each slice of bread.",
            "Layer one slice of ham, one slice of cheddar, one slice of ham, one slice of cheddar, one slice of ham.",
            "Heat a cast iron skillet over medium-low heat. Toast sandwich for 3 minutes per side with a light press until golden brown and the cheese is thoroughly melted.",
            "Enjoy"
          ],
          "artistNote": "Low heat is key so the Cheddar gets melty before the bread gets TOO Toasted."
        }
