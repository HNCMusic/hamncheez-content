  "recipes": [
    {
      "id": "recipe-001",
      "name": "The Tour Bus Classic Toasted Brioche",
      "tag": "Artist Staple",
      "prepTime": "8 mins",
      "ingredients": [
        "2 thick slices of brioche or challah bread",
        "4 slices of high-grade smoked black forest ham",
        "2 slices of aged Gruyère cheese (or sharp Swiss)",
        "1 tbsp salted butter (room temperature)",
        "1 tsp whole-grain Dijon mustard",
        "Pinch of cracked black pepper"
      ],
      "instructions": [
        "Generously butter the outside of each brioche slice.",
        "Spread whole-grain Dijon on the inside of one slice.",
        "Layer one slice of Gruyère, all the smoked ham folded loosely for airflow, the second Gruyère slice, and cracked pepper.",
        "Heat a cast iron skillet over medium-low heat. Toast sandwich for 3 minutes per side with a light press until golden brown and the cheese is thoroughly melted."
      ],
      "artistNote": "Our 2:00 AM post-soundcheck ritual. Low heat is key so the Gruyère gets molten before the brioche burns."
    },
    {
      "id": "recipe-002",
      "name": "Hot Honey & Smoked Gouda Melt",
      "tag": "Sweet & Spicy",
      "prepTime": "10 mins",
      "ingredients": [
        "2 slices artisan sourdough",
        "3 slices honey-cured ham",
        "2 slices smoked Gouda cheese",
        "1 tbsp hot chili honey",
        "1 tbsp garlic-herb butter"
      ],
      "instructions": [
        "Melt garlic butter across the exterior sourdough crust.",
        "Drizzle hot honey over the ham slices before placing in the sandwich.",
        "Layer Gouda on both top and bottom to lock in moisture.",
        "Pan sear for 3.5 minutes per side until the crust is deeply crunchy and caramelized."
      ],
      "artistNote": "Inspired by late-night diner runs after playing Nashville."
    }
  ],
